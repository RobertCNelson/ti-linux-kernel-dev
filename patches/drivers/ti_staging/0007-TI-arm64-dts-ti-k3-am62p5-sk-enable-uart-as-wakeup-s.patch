From 72857e53a0076e8f745213da2b5a122dcc2c4cdf Mon Sep 17 00:00:00 2001
From: Vibhore Vardhan <vibhore@ti.com>
Date: Wed, 5 Feb 2025 14:27:58 -0600
Subject: [PATCH 07/68] TI: arm64: dts: ti: k3-am62p5-sk: enable uart as wakeup
 source

The main_uart0 (linux serial console) can be used as a wakeup source
using I/O Daisychain to trigger system wakeup from Low Power Modes
like Deep Sleep. Based on the patch for am625.

Signed-off-by: Vibhore Vardhan <vibhore@ti.com>
Signed-off-by: Kendall Willis <k-willis@ti.com>
---
 arch/arm64/boot/dts/ti/k3-am62p5-sk.dts | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/arch/arm64/boot/dts/ti/k3-am62p5-sk.dts b/arch/arm64/boot/dts/ti/k3-am62p5-sk.dts
index c62ca0660b8b..47583ca2b7e0 100644
--- a/arch/arm64/boot/dts/ti/k3-am62p5-sk.dts
+++ b/arch/arm64/boot/dts/ti/k3-am62p5-sk.dts
@@ -728,6 +728,9 @@ mbox_mcu_r5_0: mbox-mcu-r5-0 {
 &main_uart0 {
 	pinctrl-names = "default";
 	pinctrl-0 = <&main_uart0_pins_default>;
+	interrupts-extended = <&gic500 GIC_SPI 178 IRQ_TYPE_LEVEL_HIGH>,
+			<&main_pmx0 0x1c8>; /* (D14) UART0_RXD PADCONFIG114 */
+	interrupt-names = "irq", "wakeup";
 	status = "okay";
 	bootph-all;
 };
-- 
