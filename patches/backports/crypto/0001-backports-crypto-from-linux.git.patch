-	.probe	= mcrc64_probe,
-	.remove = mcrc64_remove,
-	.driver = {
-		.name		= DRIVER_NAME,
-		.pm		= &mcrc64_pm_ops,
-		.of_match_table = of_match,
-	},
-};
