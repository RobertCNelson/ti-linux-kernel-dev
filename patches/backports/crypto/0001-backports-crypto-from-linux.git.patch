-struct dthe_data {
-	struct device *dev;
-	void __iomem *regs;
-	struct list_head list;
-	struct crypto_engine *aes_engine;
-
-	struct dma_chan *dma_aes_rx;
-	struct dma_chan *dma_aes_tx;
-
-	struct dma_chan *dma_sha_tx;
-	struct mutex hash_mutex;
-};
-
-/**
