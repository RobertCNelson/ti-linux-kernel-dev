-	dev_data = mcrc64_get_dev(tctx);
-	if (!dev_data)
-		return -ENODEV;
-
-	pm_runtime_get_sync(dev_data->dev);
-
-	tctx->key = 0;
-
-	return 0;
-}
-
-static void mcrc64_cra_exit(struct crypto_tfm *tfm)
